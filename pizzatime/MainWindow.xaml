<Window x:Class="pizzatime.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pizzatime"
        mc:Ignorable="d"
        Title="Pizza" Height="300" Width="600">
    <Grid>
        <ListBox x:Name="Lb_pizza" d:ItemsSource="{d:SampleData ItemCount=5}" ScrollViewer.CanContentScroll="True" Margin="0,-1,485,1" RenderTransformOrigin="0.5,0.5" SelectionChanged="Kivalasztas">
            <ListBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleY="0.486"/>
                    <RotateTransform/>
                    <TranslateTransform Y="1.861"/>
                </TransformGroup>
            </ListBox.RenderTransform>
        </ListBox>
        <TextBox x:Name="Tb_adás" HorizontalAlignment="Left" Margin="120,77,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="Btn_adás" Content="Hozzáadás" HorizontalAlignment="Left" Margin="120,52,0,0" VerticalAlignment="Top" Click="Adás"/>
        <Button x:Name="Btn_törlés" Content="Törlés" HorizontalAlignment="Left" Margin="205,52,0,0" VerticalAlignment="Top" Click="törlés"/>
        <TextBox x:Name="Tb_méret" HorizontalAlignment="Left" Margin="214,220,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="49"/>
        <Button x:Name="Btn_rendelés" Content="Rendelés" HorizontalAlignment="Left" Margin="180,195,0,0" VerticalAlignment="Top" Click="Rendelés"/>
        <TextBlock x:Name="Tblk_Kiválasztott" HorizontalAlignment="Left" Margin="131,220,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="78"/>
        <ListBox x:Name="Lb_Checkout" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="315,0,136,0"/>
        <TextBlock x:Name="Tblk_Rendszám" Margin="464,205,6,0" TextWrapping="Wrap" Text="Rendelések száma:" VerticalAlignment="Top" Height="79"/>
        <Button x:Name="Btn_ChckTörlSel" Content="Kijelölt Törlés" HorizontalAlignment="Left" Margin="470,40,0,0" VerticalAlignment="Top" Click="SelDelCheck"/>
        <Button x:Name="Btn_ChckTörlAll" Content="Minden Törlés" HorizontalAlignment="Left" Margin="470,70,0,0" VerticalAlignment="Top" Click="AllDelCheck"/>


    </Grid>
</Window>
